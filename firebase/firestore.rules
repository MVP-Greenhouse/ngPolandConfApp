rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function isAdmin() {
      return signedIn() && userDoc(request.auth.uid).role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user';
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /conf/{confId}/engagement/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId == 'config';
    }

    // Admin-synced allowlist. A new like requires this doc and a passed endsAt.
    match /conf/{confId}/votableEvents/{eventId} {
      function hasValidVotableEventData() {
        return request.resource.data.keys().hasOnly(['endsAt', 'track'])
          && request.resource.data.endsAt is timestamp
          && request.resource.data.track is string
          && request.resource.data.track in ['ngPoland', 'jsPoland', 'aiPoland'];
      }

      allow read: if true;
      allow create, update: if isAdmin() && hasValidVotableEventData();
      allow delete: if isAdmin();
    }

    // Public Top 5 reads the likes counter. Individual votes stay private.
    match /conf/{confId}/eventVotes/{eventId} {
      function votePath(uid) {
        return /databases/$(database)/documents/conf/$(confId)/eventVotes/$(eventId)/votes/$(uid);
      }
      function votableEventPath() {
        return /databases/$(database)/documents/conf/$(confId)/votableEvents/$(eventId);
      }
      function engagementConfigPath() {
        return /databases/$(database)/documents/conf/$(confId)/engagement/config;
      }
      function votableEventData() {
        return get(votableEventPath()).data;
      }
      function engagementConfigData() {
        return get(engagementConfigPath()).data;
      }
      function trackConfig() {
        return engagementConfigData().tracks[votableEventData().track];
      }
      function votingIsOpen() {
        return exists(votableEventPath())
          && votableEventData().endsAt is timestamp
          && votableEventData().track is string
          && exists(engagementConfigPath())
          && engagementConfigData().tracks is map
          && votableEventData().track in engagementConfigData().tracks
          && trackConfig().votingEnabled == true
          && trackConfig().votingStartsAt is timestamp
          && trackConfig().votingEndsAt is timestamp
          && request.time >= votableEventData().endsAt
          && request.time >= trackConfig().votingStartsAt
          && request.time <= trackConfig().votingEndsAt;
      }
      function likesBefore() {
        return exists(/databases/$(database)/documents/conf/$(confId)/eventVotes/$(eventId))
          ? get(/databases/$(database)/documents/conf/$(confId)/eventVotes/$(eventId)).data.get('likes', 0)
          : 0;
      }

      allow read: if true;
      allow create: if signedIn()
        && votingIsOpen()
        && request.resource.data.keys().hasOnly(['likes'])
        && request.resource.data.likes == 1
        && existsAfter(votePath(request.auth.uid));
      allow update: if signedIn()
        && votingIsOpen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && (
          (
            request.resource.data.likes == resource.data.get('likes', 0) + 1
            && !exists(votePath(request.auth.uid))
            && existsAfter(votePath(request.auth.uid))
          )
          || (
            exists(votePath(request.auth.uid))
            && !existsAfter(votePath(request.auth.uid))
            && (
              (
                resource.data.get('likes', 0) > 0
                && request.resource.data.likes == resource.data.get('likes', 0) - 1
              )
              || (
                resource.data.get('likes', 0) == 0
                && request.resource.data.likes == 0
              )
            )
          )
        );
      allow delete: if false;

      match /votes/{uid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && votingIsOpen()
          && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
          && request.resource.data.value == 1
          && getAfter(/databases/$(database)/documents/conf/$(confId)/eventVotes/$(eventId)).data.likes
              == likesBefore() + 1;
        allow update: if false;
        allow delete: if isOwner(uid)
          && votingIsOpen()
          && (
            getAfter(/databases/$(database)/documents/conf/$(confId)/eventVotes/$(eventId)).data.likes
                == likesBefore() - 1
            || (
              likesBefore() == 0
              && getAfter(/databases/$(database)/documents/conf/$(confId)/eventVotes/$(eventId)).data.likes == 0
            )
          );
      }
    }

    match /conf/{confId}/speakerVotes/{speakerId} {
      allow read: if isAdmin();
      allow write: if false;

      match /votes/{uid} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    match /conf/{confId}/contestParticipants/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /conf/{confId}/contestWinners/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /conf/{confId}/contestHistory/{contestId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Legacy star ratings are read-only; active voting uses eventVotes.
    match /conf/{confId}/{eventItemType}/{eventId}/rates/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
